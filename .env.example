# AgroShift Environment Configuration Example

# Backend Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
DATABASE_URL=sqlite:///./agroshift.db

# NASA POWER Upstream Settings
NASA_POWER_API_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=15.0

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
