{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClimateSchema",
  "definitions": {
    "MissingDataStats": {
      "type": "object",
      "required": ["missing_days_count", "total_days_count", "missing_percentage", "parameters_with_gaps"],
      "properties": {
        "missing_days_count": { "type": "integer", "minimum": 0 },
        "total_days_count": { "type": "integer", "minimum": 0 },
        "missing_percentage": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "parameters_with_gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "DailyClimateRecord": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "t2m": { "type": ["number", "null"] },
        "t2m_max": { "type": ["number", "null"] },
        "t2m_min": { "type": ["number", "null"] },
        "prectotcorr": { "type": ["number", "null"] },
        "rh2m": { "type": ["number", "null"] },
        "allsky_sfc_sw_dwn": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "MonthlyAggregate": {
      "type": "object",
      "required": ["month", "days_in_month", "valid_days"],
      "properties": {
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "days_in_month": { "type": "integer" },
        "valid_days": { "type": "integer" },
        "t2m_mean": { "type": ["number", "null"] },
        "t2m_max_mean": { "type": ["number", "null"] },
        "t2m_min_mean": { "type": ["number", "null"] },
        "prectotcorr_sum": { "type": ["number", "null"] },
        "prectotcorr_daily_mean": { "type": ["number", "null"] },
        "rh2m_mean": { "type": ["number", "null"] },
        "allsky_sfc_sw_dwn_mean": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "OverallAggregate": {
      "type": "object",
      "required": ["total_days"],
      "properties": {
        "total_days": { "type": "integer" },
        "t2m_mean": { "type": ["number", "null"] },
        "t2m_max_mean": { "type": ["number", "null"] },
        "t2m_min_mean": { "type": ["number", "null"] },
        "prectotcorr_sum": { "type": ["number", "null"] },
        "prectotcorr_daily_mean": { "type": ["number", "null"] },
        "rh2m_mean": { "type": ["number", "null"] },
        "allsky_sfc_sw_dwn_mean": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "ClimateSummary": {
      "type": "object",
      "required": [
        "source",
        "dataset_or_endpoint",
        "latitude",
        "longitude",
        "start_date",
        "end_date",
        "parameters",
        "parameter_units",
        "retrieved_at",
        "missing_data",
        "coverage_note",
        "is_demo_data",
        "overall",
        "monthly"
      ],
      "properties": {
        "source": { "type": "string" },
        "dataset_or_endpoint": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
        "longitude": { "type": "number", "minimum": -180.0, "maximum": 180.0 },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "parameters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameter_units": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "missing_data": { "$ref": "#/definitions/MissingDataStats" },
        "coverage_note": { "type": "string" },
        "is_demo_data": { "type": "boolean" },
        "overall": { "$ref": "#/definitions/OverallAggregate" },
        "monthly": {
          "type": "array",
          "items": { "$ref": "#/definitions/MonthlyAggregate" }
        }
      },
      "additionalProperties": false
    },
    "ClimateHistory": {
      "type": "object",
      "required": [
        "source",
        "dataset_or_endpoint",
        "latitude",
        "longitude",
        "start_date",
        "end_date",
        "parameters",
        "parameter_units",
        "retrieved_at",
        "missing_data",
        "coverage_note",
        "is_demo_data",
        "records"
      ],
      "properties": {
        "source": { "type": "string" },
        "dataset_or_endpoint": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
        "longitude": { "type": "number", "minimum": -180.0, "maximum": 180.0 },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "parameters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameter_units": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "missing_data": { "$ref": "#/definitions/MissingDataStats" },
        "coverage_note": { "type": "string" },
        "is_demo_data": { "type": "boolean" },
        "records": {
          "type": "array",
          "items": { "$ref": "#/definitions/DailyClimateRecord" }
        }
      },
      "additionalProperties": false
    }
  }
}
