{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EarthObservationSchema",
  "definitions": {
    "SoilMoistureIntelligence": {
      "type": "object",
      "required": [
        "source",
        "spatial_resolution",
        "recent_root_zone_moisture",
        "historical_mean",
        "moisture_anomaly",
        "unit",
        "dry_root_zone_flag",
        "interpretation",
        "data_coverage_percentage"
      ],
      "properties": {
        "source": { "type": "string" },
        "spatial_resolution": { "type": "string" },
        "grid_centroid": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        },
        "recent_root_zone_moisture": { "type": ["number", "null"] },
        "historical_mean": { "type": ["number", "null"] },
        "moisture_anomaly": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "dry_root_zone_flag": { "type": "boolean" },
        "interpretation": { "type": "string" },
        "data_coverage_percentage": { "type": "number" }
      },
      "additionalProperties": false
    },
    "PrecipitationIntelligence": {
      "type": "object",
      "required": [
        "source",
        "product_run",
        "spatial_resolution",
        "seasonal_rainfall_total_mm",
        "daily_mean_mm",
        "rainfall_deficit_mm",
        "consecutive_dry_days",
        "heavy_rain_days",
        "dry_spell_risk",
        "interpretation"
      ],
      "properties": {
        "source": { "type": "string" },
        "product_run": { "type": "string" },
        "spatial_resolution": { "type": "string" },
        "seasonal_rainfall_total_mm": { "type": ["number", "null"] },
        "daily_mean_mm": { "type": ["number", "null"] },
        "rainfall_deficit_mm": { "type": ["number", "null"] },
        "consecutive_dry_days": { "type": "integer" },
        "heavy_rain_days": { "type": "integer" },
        "dry_spell_risk": { "type": "boolean" },
        "interpretation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "VegetationIntelligence": {
      "type": "object",
      "required": [
        "source",
        "spatial_resolution",
        "recent_mean_ndvi",
        "historical_mean_ndvi",
        "ndvi_anomaly",
        "low_greenness_flag",
        "bare_field_likelihood",
        "interpretation"
      ],
      "properties": {
        "source": { "type": "string" },
        "spatial_resolution": { "type": "string" },
        "recent_mean_ndvi": { "type": ["number", "null"] },
        "historical_mean_ndvi": { "type": ["number", "null"] },
        "ndvi_anomaly": { "type": ["number", "null"] },
        "low_greenness_flag": { "type": "boolean" },
        "bare_field_likelihood": { "type": "string" },
        "interpretation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "BareFieldWindow": {
      "type": "object",
      "required": [
        "start_date",
        "end_date",
        "duration_days",
        "evidence",
        "risk",
        "interpretation",
        "confidence"
      ],
      "properties": {
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "duration_days": { "type": "integer" },
        "evidence": {
          "type": "object",
          "properties": {
            "ndvi_mean": { "type": ["number", "null"] },
            "root_zone_soil_moisture": { "type": ["number", "null"] },
            "recent_precipitation_mm": { "type": ["number", "null"] },
            "mean_temperature_c": { "type": ["number", "null"] }
          }
        },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "interpretation": { "type": "string" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    },
    "HeatStressIntelligence": {
      "type": "object",
      "required": [
        "source",
        "heat_stress_days",
        "frost_risk_days",
        "consecutive_hot_days",
        "interpretation"
      ],
      "properties": {
        "source": { "type": "string" },
        "heat_stress_days": { "type": "integer" },
        "frost_risk_days": { "type": "integer" },
        "consecutive_hot_days": { "type": "integer" },
        "interpretation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "EarthObservationDataQuality": {
      "type": "object",
      "required": [
        "available_sources",
        "unavailable_sources",
        "missing_percentage_by_source",
        "overall_confidence",
        "earliest_observation_date",
        "latest_observation_date"
      ],
      "properties": {
        "available_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unavailable_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "status": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "missing_percentage_by_source": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "overall_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "not_enough_information"]
        },
        "earliest_observation_date": { "type": ["string", "null"] },
        "latest_observation_date": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "EarthObservationProvenance": {
      "type": "object",
      "required": [
        "source_name",
        "product_id",
        "spatial_resolution",
        "temporal_resolution",
        "measurement",
        "retrieval_method"
      ],
      "properties": {
        "source_name": { "type": "string" },
        "product_id": { "type": "string" },
        "spatial_resolution": { "type": "string" },
        "temporal_resolution": { "type": "string" },
        "measurement": { "type": "string" },
        "retrieval_method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FarmEarthObservation": {
      "type": "object",
      "required": [
        "farm_id",
        "latitude",
        "longitude",
        "analysis_period",
        "bare_field_windows",
        "data_quality",
        "provenance",
        "limitations",
        "is_demo_data"
      ],
      "properties": {
        "farm_id": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "analysis_period": {
          "type": "object",
          "required": [
            "recent_start_date",
            "recent_end_date",
            "historical_start_date",
            "historical_end_date"
          ],
          "properties": {
            "recent_start_date": { "type": "string" },
            "recent_end_date": { "type": "string" },
            "historical_start_date": { "type": "string" },
            "historical_end_date": { "type": "string" }
          }
        },
        "soil_moisture": {
          "anyOf": [
            { "$ref": "#/definitions/SoilMoistureIntelligence" },
            { "type": "null" }
          ]
        },
        "climate": { "type": ["object", "null"] },
        "precipitation": {
          "anyOf": [
            { "$ref": "#/definitions/PrecipitationIntelligence" },
            { "type": "null" }
          ]
        },
        "vegetation": {
          "anyOf": [
            { "$ref": "#/definitions/VegetationIntelligence" },
            { "type": "null" }
          ]
        },
        "bare_field_windows": {
          "type": "array",
          "items": { "$ref": "#/definitions/BareFieldWindow" }
        },
        "heat_stress": {
          "anyOf": [
            { "$ref": "#/definitions/HeatStressIntelligence" },
            { "type": "null" }
          ]
        },
        "data_quality": { "$ref": "#/definitions/EarthObservationDataQuality" },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/definitions/EarthObservationProvenance" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "is_demo_data": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
