{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApiError",
  "type": "object",
  "required": ["error_code", "message", "details", "request_id"],
  "properties": {
    "error_code": {
      "type": "string",
      "description": "Machine-readable error code"
    },
    "message": {
      "type": "string",
      "description": "Human-readable error explanation"
    },
    "details": {
      "description": "Structured error context or null",
      "type": ["object", "array", "string", "null"]
    },
    "request_id": {
      "type": ["string", "null"],
      "description": "Unique UUID request identifier"
    }
  },
  "additionalProperties": false
}
